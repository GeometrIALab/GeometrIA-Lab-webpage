---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for pair in site.data.routes -%}
{%- assign key = pair[0] -%}
{%- assign r = pair[1] -%}
{%- if key != "nav" and key != "notfound" %}
  {%- for lang in (1..2) %}
  {%- if forloop.first -%}{%- assign loc = r.pt -%}{%- else -%}{%- assign loc = r.en -%}{%- endif %}
  <url>
    <loc>{{ loc | absolute_url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <xhtml:link rel="alternate" hreflang="pt-BR" href="{{ r.pt | absolute_url }}"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ r.en | absolute_url }}"/>
  </url>
  {%- endfor %}
{%- endif %}
{%- endfor %}
{%- for p in site.posts %}
  {%- assign twin = nil -%}
  {%- if p.key -%}{%- assign twin = site.posts | where: "key", p.key | where_exp: "q", "q.lang != p.lang" | first -%}{%- endif %}
  <url>
    <loc>{{ p.url | absolute_url }}</loc>
    <lastmod>{{ p.date | date_to_xmlschema }}</lastmod>
    {%- if twin %}
    <xhtml:link rel="alternate" hreflang="{% if p.lang == 'en' %}en{% else %}pt-BR{% endif %}" href="{{ p.url | absolute_url }}"/>
    <xhtml:link rel="alternate" hreflang="{% if twin.lang == 'en' %}en{% else %}pt-BR{% endif %}" href="{{ twin.url | absolute_url }}"/>
    {%- endif %}
  </url>
{%- endfor %}
</urlset>
